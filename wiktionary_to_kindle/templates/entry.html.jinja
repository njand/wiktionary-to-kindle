{%- import 'macros.html.jinja' as macros -%}
<idx:entry name="{{ entry.language.index_name }}" scriptable="yes" spell="yes" exact="yes" id="{{ entry.id_number }}">
    {%- set main_header = valid_pairs[0][1] -%}
    {#- One line: headword, principal parts, gender, part of speech and class -#}
    <p><idx:orth value="{{ orth | e }}"><font size="+1"><b>
            {{- main_header.prefix | e -}}{{- main_header.head_word | e -}}
            </b></font>
            {%- if iforms -%}
            <idx:infl>
                {%- for form in iforms -%}
                <idx:iform value="{{ form | e }}" exact="yes" />
                {%- endfor -%}
            </idx:infl>
            {%- endif -%}
        </idx:orth>
        {{- headline_tail(main_header, entry.pos) | safe -}}
    </p>

    {%- for block, header in valid_pairs -%}
        {%- if loop.index0 > 0 -%}
            <p><font size="+1"><b>{{ header.prefix | e }}{{ header.head_word | e }}</b></font>
            {{- headline_tail(header, entry.pos) | safe -}}</p>
        {%- endif -%}
        
        {{- macros.render_senses(block, recursive_senses) -}}
    {%- endfor -%}

    {#- Alternative forms, diminutives and the like share one line -#}
    {%- if entry.related -%}
        <p>
        {%- for kind, words in entry.related -%}
            <i>{{ kind }}</i> {% for group, gloss in by_gloss(words) -%}
                {% for word in group %}<b>{{ word | e }}</b>{% if not loop.last %}, {% endif %}{% endfor -%}
                {% if gloss %}: {{ gloss | e }}{% endif %}{% if not loop.last %}; {% endif %}
            {%- endfor %}{% if not loop.last %} &#183; {% endif %}
        {%- endfor -%}
        </p>
    {%- endif -%}

    {#- Etymology and descendants: a bold label, then smaller grey text -#}
    {%- if include_etymology and entry.etymology and entry.etymology.etymology_text -%}
        <p><b>Etymology.</b> <font size="-1" color="#555555">
            {{- format_etymology(entry.etymology) | safe -}}
        </font></p>
    {%- endif -%}

    {%- if descendants -%}
        <p><b>Descendants.</b> <font size="-1" color="#555555">
        {%- for lang, words in descendants -%}
            <b>{{ short_language(lang) | e }}</b> {{ words | join(", ") | e }}{% if not loop.last %} &#183; {% endif %}
        {%- endfor -%}
        </font></p>
    {%- endif -%}
</idx:entry>