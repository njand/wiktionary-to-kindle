{%- import 'macros.html.jinja' as macros -%}
<idx:entry name="Latin" scriptable="yes" spell="yes" exact="yes" id="{{ entry.id_number }}">
    {%- set main_header = valid_pairs[0][1] -%}
    {#- One line: headword, its forms and declension, part of speech -#}
    <p><idx:orth value="{{ orth | e }}"><b>
            {{- main_header.prefix | e -}}{{- main_header.head_word | e -}}
            </b>
            {%- if iforms -%}
            <idx:infl>
                {%- for form in iforms -%}
                <idx:iform value="{{ form | e }}" exact="yes" />
                {%- endfor -%}
            </idx:infl>
            {%- endif -%}
        </idx:orth>
        {{- macros.header_tail(main_header, entry.pos) -}}
    </p>

    {%- for block, header in valid_pairs -%}
        {%- if loop.index0 > 0 -%}
            <p><b>{{ header.prefix | e }}{{ header.head_word | e }}</b>
            {{- macros.header_tail(header, entry.pos) -}}</p>
        {%- endif -%}
        
        {{- macros.render_senses(block, recursive_senses) -}}
    {%- endfor -%}

    {#- Alternative forms, diminutives and the like share one line -#}
    {%- if entry.related -%}
        <p>
        {%- for kind, words in entry.related -%}
            <i>{{ kind }}</i> {% for word, gloss in words -%}
                <b>{{ word | e }}</b>{% if gloss %}: {{ gloss | e }}{% endif %}{% if not loop.last %}; {% endif %}
            {%- endfor %}{% if not loop.last %}; {% endif %}
        {%- endfor -%}
        </p>
    {%- endif -%}

    {%- if include_etymology and entry.etymology and entry.etymology.etymology_text -%}
        <p><i>Etym.</i> {{ format_etymology(entry.etymology) | safe }}</p>
    {%- endif -%}

    {%- if descendants -%}
        <p><i>Desc.</i> {% for lang, words in descendants -%}
            {{ short_language(lang) | e }} {{ words | join(", ") | e }}{% if not loop.last %}; {% endif %}
        {%- endfor %}</p>
    {%- endif -%}
</idx:entry>