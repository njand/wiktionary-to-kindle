<idx:entry name="Latin" scriptable="yes" spell="yes" exact="yes" id="card_{{ card.id_number }}">
    <h3>
        <idx:orth value="{{ card.labels[0] | e }}">
            {{- card.labels[0] | e -}}
            {%- if card.labels | length > 1 -%}
            <idx:infl>
                {%- for label in card.labels[1:] -%}
                <idx:iform value="{{ label | e }}" exact="yes" />
                {%- endfor -%}
            </idx:infl>
            {%- endif -%}
        </idx:orth>
    </h3>
    <ol>
    {%- for row in rows -%}
        <li>
            {%- if row.page -%}
                <a href="{{ row.page }}#{{ row.id }}"><b>{{ row.head | e }}</b></a>
            {%- else -%}
                <b>{{ row.head | e }}</b>
            {%- endif -%}
            {%- if row.pos %} <span class="pos">{{ row.pos | e }}</span>{% endif -%}
            {%- if row.parses %} <span class="tag">{{ row.parses | join("; ") | e }}</span>{% endif -%}
            {%- if row.gloss %}: {{ row.gloss | safe }}{% endif -%}
        </li>
    {%- endfor -%}
    </ol>
</idx:entry>
